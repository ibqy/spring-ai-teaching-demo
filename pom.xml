<?xml version="1.0" encoding="UTF-8"?>
<!--
  作者：ibqy
  日期：2026-09-10
  这是一个面向初学者的 Spring AI 教学演示项目（Spring AI Teaching Demo）。
  采用增量式教学：demo01 ~ demo17 循序渐进，每个 demo 用最少的代码讲清一个 Spring AI 知识点。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      1) 复用 spring-boot-starter-parent 统一管理 Spring Boot 相关依赖版本。
      Spring AI 2.0.x 官方支持 Spring Boot 4.0.x / 4.1.x，因此这里使用 4.1.0。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.xb</groupId>
    <artifactId>spring-ai-teaching-demo</artifactId>
    <version>1.0.0</version>
    <name>spring-ai-teaching-demo</name>
    <description>面向初学者的 Spring AI 教学演示项目</description>

    <properties>
        <!-- 2) 编译目标：Spring AI 2.0 强制要求 Java 21+（虚拟线程、AOT 等新特性） -->
        <java.version>21</java.version>
        <!-- 3) Spring AI 版本集中管理，便于统一升级 -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- 3.1) Agent Skills 社区工具库版本（demo14），不在 Spring AI BOM 内，单独管理 -->
        <spring-ai-agent-utils.version>0.12.0</spring-ai-agent-utils.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              4) 引入 Spring AI BOM（Bill of Materials，仅版本清单）。
              BOM 只声明所有 Spring AI 依赖的推荐版本，具体用哪些依赖由我们按需添加。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          5) Web 支持：本项目用 REST 接口来演示，是最基础的依赖。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          6) Spring AI 的 OpenAI 模型启动器（封装了 ChatModel / EmbeddingModel / ImageModel 等自动配置）。
             注意：它对接的是 "OpenAI 兼容" 接口，像 DeepSeek、智谱、通义千问、Ollama 等
             兼容 OpenAI 协议的服务都可以通过配置 base-url 切换。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
          7) 校验支持：用于 @Valid / @RequestParam 等参数校验（结构化输出的实体校验也需要）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          8) VectorStore 支持：demo08 的 RAG（检索增强生成）示例用到 SimpleVectorStore（内存向量库）。
             RAG 里还需要 EmbeddingModel 将文本转成向量——这已经由上面的 openai 启动器提供。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <!--
          9) ETL 文档管道支持（demo13）：spring-ai-tika-document-reader 基于 Apache Tika，
             一个 Reader 即可解析 PDF、Word（doc/docx）、PPT、HTML、Markdown 等格式，
             把文档统一读成 List<Document>，随后走 TokenTextSplitter 切分 → VectorStore 写入
             的标准 ETL 管道。TokenTextSplitter 位于 spring-ai-commons，
             已由上面的 vector-store 传递依赖引入，无需重复添加。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tika-document-reader</artifactId>
        </dependency>

        <!--
          10) Agent Skills 支持（demo14）：spring-ai-agent-utils 社区库提供
              SkillsTool（加载 SKILL.md 技能）、FileSystemTools（读文档）、
              ShellTools（执行脚本）。其传递依赖 spring-ai-client-chat 2.0.1
              与 Spring AI BOM 管理的 2.0.1 一致，可放心使用。
        -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agent-utils</artifactId>
            <version>${spring-ai-agent-utils.version}</version>
        </dependency>

        <!--
          10.1) MCP 客户端支持（demo16）：Model Context Protocol 是 2024 年底由 Anthropic
                发布、现已被 OpenAI / Google / 微软等主流厂商采纳的"AI 应用与外部工具
                之间的 USB-C 标准"。引入该启动器后，配置 stdio / sse 服务器即可把
                MCP 服务器的工具自动转换为 Spring AI 的 ToolCallback 供模型调用。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!--
          10.2) WebFlux 支持：为 MCP 客户端的 SSE（Server-Sent Events）传输模式
                提供 WebClient。注意：与 starter-web 共存时应用仍是 Servlet（Tomcat），
                WebFlux 仅作为 WebClient 类库使用，不影响 demo01~demo15 的运行。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!--
          10.3) Nacos 客户端支持（demo15）：用于配置中心做技能指令热更新与回滚。
        -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!--
          11) 测试支持。教学示例中给出 demo05 的纯逻辑单元测试（不依赖真实大模型，离线可跑）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
